# 백엔드 API 기본 주소
BACKEND_API_BASE_URL=http://localhost:8080

# 브라우저와 서버에서 오류를 전송할 Sentry DSN
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# 소스맵 업로드용 Sentry 빌드 설정
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_RELEASE=

# 성능 측정용 친구·추천 상품 목업 데이터 사용 여부 (true일 때만 목업 사용)
NEXT_PUBLIC_USE_MOCK_DATA=false

# 목업 상품 이미지 형식 (webp: 350px WebP 썸네일, jpg: 800px JPEG, 미지정 시 webp)
NEXT_PUBLIC_MOCK_IMAGE_FORMAT=webp

# 성능 측정용 계측 코드 사용 여부 (true일 때만 계측, npm run build:perf에서 자동 지정)
NEXT_PUBLIC_PERF_INSTRUMENT=false
